    "description": "Error shown when the SDK of the project is outside the supported versions.",
    "placeholders": {"found": {"type": "String"}, "window": {"type": "String"}}
  },
  "projectSummary": "{name} · Flutter {version}",
  "@projectSummary": {
    "description": "Name of the open project and version of its SDK, in the toolbar.",
    "placeholders": {"name": {"type": "String"}, "version": {"type": "String"}}
  },
  "runAction": "Run",
  "@runAction": {"description": "Label of the button that starts the app."},
  "runInWindowAction": "Run in a window",
  "@runInWindowAction": {"description": "Label of the button that builds the app for the desktop and opens it in its own window."},
  "stopAction": "Stop",
  "@stopAction": {"description": "Label of the button that ends the app."},
  "hotRestartAction": "Restart",
  "@hotRestartAction": {"description": "Label of the button that restarts the app with the code on disk."},
  "undoAction": "Undo",
  "@undoAction": {"description": "Label of the button that undoes the last edit."},
  "redoAction": "Redo",
  "@redoAction": {"description": "Label of the button that applies again the edit that was undone."},
  "wrapWithAction": "Wrap with",
  "@wrapWithAction": {"description": "Label of the menu that wraps the selected widget with another widget."},
  "removeWidgetAction": "Remove the widget and keep its children",
  "@removeWidgetAction": {"description": "Tooltip of the button that removes the selected widget from the code."},
  "moveUpAction": "Move up among the siblings",
  "@moveUpAction": {"description": "Tooltip of the button that moves the selected widget before its previous sibling."},
  "moveDownAction": "Move down among the siblings",
  "@moveDownAction": {"description": "Tooltip of the button that moves the selected widget after its next sibling."},
  "swapWithParentAction": "Swap with the parent",
  "@swapWithParentAction": {"description": "Tooltip of the button that swaps the selected widget with its parent."},
  "swapWithChildAction": "Swap with the child",
  "@swapWithChildAction": {"description": "Tooltip of the button that swaps the selected widget with its child."},
  "startingApp": "Starting the app…",
  "@startingApp": {"description": "Text shown in the toolbar while the app is being built and started."},
  "widgetTreePlaceholder": "Run the app to see its widget tree.",
  "@widgetTreePlaceholder": {"description": "Text shown in place of the widget tree while the app is not running."},
  "structureTitle": "Structure",
  "@structureTitle": {"description": "Title of the pane with the tree of widgets derived from the source of a file."},
  "structurePlaceholder": "No widget is created in this file.",
  "@structurePlaceholder": {"description": "Text shown in place of the source tree when the file creates no widget or the tree is not known yet."},
  "canvasTitle": "Canvas",
  "@canvasTitle": {"description": "Title of the tab that shows the frames of the running app."},
  "inspectorTitle": "Inspector",
  "@inspectorTitle": {"description": "Title of the tab with the widget tree of the running app."},
  "canvasPlaceholder": "Run the app to see it here.",
  "@canvasPlaceholder": {"description": "Text shown in the canvas before the app has drawn anything."},
  "canvasStale": "The app is not running. This is its last frame.",
  "@canvasStale": {"description": "Notice over the canvas when the frame on screen is of an app that ended."},
  "propertiesTitle": "Properties",
  "@propertiesTitle": {"description": "Title of the pane that edits the arguments of the selected widget."},
  "outputTitle": "Output",
  "@outputTitle": {"description": "Title of the pane with the output of the build and of the app."}
