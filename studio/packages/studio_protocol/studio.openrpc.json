  "components": {
    "schemas": {
      "VersionInfo": {
        "description": "The version of the contract of the Studio service.",
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "description": "Semantic version of the contract.",
            "type": "string"
          }
        }
      },
      "Position": {
        "description": "A position in a document, as the Language Server Protocol counts it.",
        "type": "object",
        "required": [
          "line",
          "character"
        ],
        "properties": {
          "line": {
            "description": "Line of the position, starting at zero.",
            "type": "integer"
          },
          "character": {
            "description": "Offset in UTF-16 code units from the start of the line, starting at zero.",
            "type": "integer"
          }
        }
      },
      "Range": {
        "description": "The text between two positions of a document.",
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "start": {
            "description": "First position of the range.",
            "$ref": "#/components/schemas/Position"
          },
          "end": {
            "description": "Position after the last one of the range.",
            "$ref": "#/components/schemas/Position"
          }
        }
      },
      "WidgetRef": {
        "description": "The creation location of a widget, in one version of the document.",
        "type": "object",
        "required": [
          "uri",
          "position",
          "documentVersion"
        ],
        "properties": {
          "uri": {
            "description": "The file URI of the document that creates the widget.",
            "type": "string"
          },
          "position": {
            "description": "Position of the constructor call that creates the widget.",
            "$ref": "#/components/schemas/Position"
          },
          "documentVersion": {
            "description": "Version of the document in which the position is valid.",
            "type": "integer"
          }
        }
      },
      "Expression": {
        "description": "A Dart expression, as source text.",
        "type": "object",
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "description": "The source text of the expression.",
            "type": "string"
          }
        }
      },
      "Property": {
        "description": "One parameter of the constructor that creates a widget.",
        "type": "object",
        "required": [
          "name",
          "type",
          "isSet",
          "isEditable"
        ],
        "properties": {
          "name": {
            "description": "Name of the parameter.",
            "type": "string"
          },
          "type": {
            "description": "Kind of value, as the analysis server names it: string, int, double, bool, enum, or another name for a value that is not editable as a literal.",
            "type": "string"
          },
          "expression": {
            "description": "The argument in the code, absent when no argument is given.",
            "$ref": "#/components/schemas/Expression"
          },
          "defaultValue": {
            "description": "The default value of the parameter, absent when it has none.",
            "$ref": "#/components/schemas/Expression"
          },
          "isSet": {
            "description": "Whether the code gives an argument for the parameter.",
            "type": "boolean"
          },
          "isEditable": {
            "description": "Whether setProperty accepts the parameter.",
            "type": "boolean"
          },
          "options": {
            "description": "The values that an enum parameter accepts, absent for the other kinds.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "documentation": {
            "description": "Documentation of the parameter, absent when it has none.",
            "type": "string"
          }
        }
      },
      "TextEdit": {
        "description": "Replacement of the text of a range.",
        "type": "object",
        "required": [
          "range",
          "newText"
        ],
        "properties": {
          "range": {
            "description": "The replaced text, in the document before the edit.",
            "$ref": "#/components/schemas/Range"
          },
          "newText": {
            "description": "The text that takes the place of the range.",
            "type": "string"
          }
        }
      },
      "TextDocumentEdit": {
        "description": "The edits made to one document.",
        "type": "object",
        "required": [
          "uri",
          "edits"
        ],
        "properties": {
          "uri": {
            "description": "The file URI of the document.",
            "type": "string"
          },
          "edits": {
            "description": "The edits, with ranges that refer to the document before any of them.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TextEdit"
            }
          }
        }
      },
      "ReloadKind": {
        "description": "How the running app was asked to pick up an edit.",
        "type": "string",
        "enum": [
          "hotReload",
          "hotRestart",
          "none"
        ]
      },
      "EditResult": {
